{
  "name": "thefence",
  "version": "1.0.0",
  "description": "THEFENCE doctrine validation and build system",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "thefence": "./dist/cli.js",
    "thefence-anomaly": "./dist/clis/anomaly.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "npm run build && npm test && node dist/cli.js validate",
    "server": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": ["thefence", "doctrine", "validation", "governance"],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  }
}
