// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         String      @default("VIEWER")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorRole     String   // ADMIN, OPERATOR, SYSTEM, UNKNOWN
  actorUsername String?
  action        String   // LOGIN_SUCCESS, LOGOUT, DEPLOY_CHANGE_REQUEST, etc.
  status        String   // SUCCESS, FAIL
  ip            String?
  userAgent     String?
  meta          Json?    // Extra context as JSON
  details       String?  // Legacy field, kept for compatibility
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorRole])
}

model Event {
  id        String   @id @default(cuid())
  type      String
  message   String
  createdAt DateTime @default(now())
}

model Guardrail {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String
  threshold String
  current   String
  updatedAt DateTime @updatedAt
}

model Config {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model SystemState {
  id         Int      @id @default(1)
  state      String
  message    String
  lastUpdate DateTime @default(now())
}
